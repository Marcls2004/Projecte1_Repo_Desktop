                  <TableColumn fx:id="colSeient" prefWidth="130.0" text="Seient" />
                  <TableColumn fx:id="colComprador" prefWidth="140.0" text="Comprador" />
                  <TableColumn fx:id="colEstat" prefWidth="90.0" text="Estat" />
               </columns>
