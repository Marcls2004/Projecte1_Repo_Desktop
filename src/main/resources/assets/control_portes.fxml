<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="520.0" prefWidth="780.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.projecte.PortesController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Control d'accés">
         <font>
            <Font size="32.0" />
         </font>
      </Label>

      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <TextField fx:id="tfLocalitzador" onAction="#validar" prefWidth="300.0" promptText="Localitzador de l'entrada">
               <font>
                  <Font size="18.0" />
               </font>
            </TextField>
            <Button mnemonicParsing="false" onAction="#validar" text="Validar">
               <font>
                  <Font size="18.0" />
               </font>
            </Button>
         </children>
      </HBox>

      <VBox fx:id="panellResultat" alignment="CENTER" prefHeight="220.0" prefWidth="600.0" spacing="10.0" style="-fx-background-color: #eeeeee; -fx-background-radius: 10;">
         <children>
            <Label fx:id="lbResultat" text="Esperant localitzador..." textFill="#555555">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <Label fx:id="lbDetall" textFill="WHITE" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <Button fx:id="btnTornar" mnemonicParsing="false" onAction="#tornar" text="Tornar" />
   </children>
</VBox>